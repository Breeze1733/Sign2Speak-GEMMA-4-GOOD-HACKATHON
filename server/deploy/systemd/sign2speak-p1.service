[Unit]
Description=Sign2Speak P1/P2 remote service (Gemma G2T + TFLite M3)
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
WorkingDirectory=/opt/sign2speak/app/p1
EnvironmentFile=/opt/sign2speak/app/.env
Environment=PYTHONPATH=/opt/sign2speak/app/p1
ExecStart=/opt/sign2speak/venv/bin/uvicorn service:app --host 0.0.0.0 --port 8080 --workers 1 --log-level info --no-access-log
Restart=always
RestartSec=5
# Model load can take a while on CPU; do not let systemd kill it early.
TimeoutStartSec=600
# Keep timing measurements clean: no THP surprises, allow the model to stay resident.
LimitMEMLOCK=infinity

[Install]
WantedBy=multi-user.target
