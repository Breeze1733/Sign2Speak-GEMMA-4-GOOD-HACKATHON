# Copy to /opt/sign2speak/app/.env and edit.
# Leave S2S_TOKEN empty only on an isolated network; otherwise set a long random value.
S2S_TOKEN=change-me-to-a-long-random-string

MODEL_PATH=/opt/sign2speak/models/gemma-4-E2B-it.litertlm
MODEL_VERSION=gemma-4-E2B-it.litertlm
CACHE_DIR=/opt/sign2speak/cache
LOG_PATH=/opt/sign2speak/logs/p1.jsonl

# CPU backend tuning. THREADS should be <= nproc (4 on this instance).
THREADS=4
MAX_OUTPUT_TOKENS=64
MAX_NUM_TOKENS=2048
TIMEOUT_S=60
QUEUE_MAX=8

# ---- P2: remote M3 (preprocess + TFLite classifier + 8-vote) ----
P2_ENABLED=1
CLASSIFIER_PATH=/opt/sign2speak/models/classifier.tflite
CLASSIFIER_META=/opt/sign2speak/models/model_meta.json
CLASSIFIER_VERSION=islr-conv1d-transformer-v1
# Keep 1 thread: Gemma already uses THREADS on the same 4 vCPUs.
CLASSIFIER_THREADS=1
CLASSIFIER_RUNTIME=auto
P2_LOG_PATH=/opt/sign2speak/logs/p2.jsonl
P2_QUEUE_MAX=64
P2_TIMEOUT_S=3
P2_SESSION_TTL_S=600
P2_SESSION_MAX=32
P2_MAX_BODY_BYTES=2097152
P2_DUMP_WINDOWS=0
P2_DUMP_DIR=/opt/sign2speak/results/windows
P2_STRICT_VERSION=0
